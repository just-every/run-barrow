  "description": "Private wholesale catalogues, customer order review, supplier-approved Pier reservations, invoice CSV handoff and reviewed account move-in.",
  "capabilities": [
    {
      "id": "trade-accounts",
      "clauses": [
        "BAR-001"
      ]
    },
    {
      "id": "wholesale-orders",
      "clauses": [
        "BAR-002"
      ]
    },
    {
      "id": "agent-drafts",
      "clauses": [
        "BAR-003"
      ]
    },
    {
      "id": "account-move-in",
      "clauses": [
        "BAR-004"
      ]
    },
    {
      "id": "data-portability",
      "clauses": [
        "BAR-005"
      ]
    }
  ],
  "nonGoals": [
    "Consumer storefront",
    "Card checkout or payment collection",
    "Tax calculation and shipping rates",
    "ERP or a second stock ledger",
    "Brand and homepage design"
  ],
  "externals": [
    {
      "id": "cloudflare",
      "required": true,
      "why": "Worker hosting",
      "data": [
        "HTTP requests"
      ],
      "adapters": []
    },
    {
      "id": "pier",
