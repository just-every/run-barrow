{
  "name": "@wholesale/barrow",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "rer queue verify:app -- sh -c \"pnpm run build && pnpm run typecheck && pnpm check:deployment-spec && node scripts/edition-authoring/cli.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline && pnpm run test:api && rer build --site && node --test tests/site.test.mjs\"",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "outbox": "rer outbox",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:api": "rer queue test:api -- node scripts/test-api.mjs",
    "delivery:spec": "node scripts/build-deployment-spec.mjs",
    "check:deployment-spec": "node scripts/build-deployment-spec.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "edgeport": "1.0.6",
    "fflate": "0.8.3",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.86",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "marked": "18.1.1",
    "miniflare": "5.20260907.0-alpha",
    "ssh2": "1.17.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1",
    "ws": "8.21.0"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "license": "MIT",
  "repository": "https://github.com/just-every/run-barrow"
}
