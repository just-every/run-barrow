{
  "version": 1,
  "project": "wholesale/barrow",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "crons": [
    "0 * * * *"
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "auth@example.invalid"
  },
  "secrets": [
    {
      "binding": "MAIL_EVENT_TENANT",
      "environment": "MAIL_EVENT_TENANT",
      "optional": true
    },
    {
      "binding": "MAIL_WEBHOOK_SECRET",
      "environment": "MAIL_WEBHOOK_SECRET",
      "optional": true
    },
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "PIER_ORIGIN",
      "environment": "PIER_ORIGIN",
      "optional": true,
      "verifyStandIn": "https://barrow-agent-inventory.example.invalid"
    },
    {
      "binding": "PIER_SESSION",
      "environment": "PIER_SESSION",
      "optional": true,
      "verifyStandIn": "barrow-agent-conformance"
    },
    {
      "binding": "BARROW_SFTP_SECRETS",
      "environment": "BARROW_SFTP_SECRETS",
      "optional": true
    },
    {
      "binding": "FAIRE_CONNECTIONS",
      "environment": "FAIRE_CONNECTIONS",
      "optional": true
    }
  ],
  "platforms": [
    "workers",
    "container"
  ],
  "r2": [
    {
      "binding": "ERASURE_JOURNAL"
    }
  ]
}
