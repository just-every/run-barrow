{
  "version": 1,
  "project": "wholesale/barrow",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "crons": [
    "0 * * * *"
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": ""
  },
  "secrets": [
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER",
      "optional": true,
      "verifyStandIn": "resend"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "optional": true,
      "verifyStandIn": "auth@example.test"
    },
    {
      "binding": "MAIL_RELAY_URL",
      "environment": "MAIL_RELAY_URL",
      "optional": true
    },
    {
      "binding": "MAIL_EVENT_TENANT",
      "environment": "MAIL_EVENT_TENANT",
      "optional": true
    },
    {
      "binding": "MAIL_WEBHOOK_SECRET",
      "environment": "MAIL_WEBHOOK_SECRET",
      "optional": true
    },
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY",
      "optional": true,
      "verifyStandIn": "test-only-provider-key"
    },
    {
      "binding": "MAIL_ACCOUNT_ID",
      "environment": "MAIL_ACCOUNT_ID",
      "optional": true
    },
    {
      "binding": "PIER_ORIGIN",
      "environment": "PIER_ORIGIN",
      "optional": true
    },
    {
      "binding": "PIER_SESSION",
      "environment": "PIER_SESSION",
      "optional": true
    },
    {
      "binding": "BARROW_SFTP_SECRETS",
      "environment": "BARROW_SFTP_SECRETS",
      "optional": true
    },
    {
      "binding": "FAIRE_CONNECTIONS",
      "environment": "FAIRE_CONNECTIONS",
      "optional": true
    },
    {
      "binding": "QBO_CLIENT_ID",
      "environment": "QBO_CLIENT_ID",
      "optional": true
    },
    {
      "binding": "QBO_CLIENT_SECRET",
      "environment": "QBO_CLIENT_SECRET",
      "optional": true
    }
  ],
  "platforms": [
    "workers",
    "container"
  ],
  "r2": [
    {
      "binding": "ERASURE_JOURNAL"
    }
  ],
  "publicSettings": [
    "MAIL_PROVIDER",
    "MAIL_FROM",
    "MAIL_RELAY_URL",
    "MAIL_ACCOUNT_ID"
  ]
}
