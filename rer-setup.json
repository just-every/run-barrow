{
  "schema": 1,
  "title": "Barrow",
  "groups": [
    {
      "id": "application",
      "label": "Your application"
    },
    {
      "id": "owner",
      "label": "First owner"
    }
  ],
  "fields": [
    {
      "name": "APP_NAME",
      "label": "Application name",
      "help": "The name shown in your new application.",
      "kind": "text",
      "required": true,
      "default": "Barrow",
      "group": "application"
    },
    {
      "name": "PRIMARY_COLOR",
      "label": "Brand colour",
      "kind": "colour",
      "required": true,
      "default": "#12161E",
      "group": "application"
    },
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "First owner address. Local sign-in links stay in the private development outbox; hosted mail uses the selected provider.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": true,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "help": "Optional Auth install. Leave empty to use email links.",
      "default": ""
    },
    {
      "name": "PIER_ORIGIN",
      "label": "Pier origin",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Existing Pier stock desk. HTTPS hosted; loopback HTTP locally."
    },
    {
      "name": "PIER_SESSION",
      "label": "Pier supplier session cookie",
      "kind": "secret",
      "input": "entered",
      "required": false,
      "ownerVisible": true,
      "help": "Current Pier operator or owner session cookie. Kept server-side; customers never receive it."
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail provider",
      "kind": "select",
      "required": true,
      "default": "rer",
      "options": [
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "cloudflare",
          "label": "Cloudflare Email Sending"
        }
      ]
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender address",
      "kind": "text",
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      }
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "ownerVisible": true,
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_ACCOUNT_ID",
      "label": "Cloudflare account ID",
      "kind": "text",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "cloudflare"
      }
    },
    {
      "name": "MAIL_EVENT_TENANT",
      "label": "Resend delivery tenant",
      "kind": "text",
      "required": false,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "resend"
      },
      "help": "Optional quote-delivery event tenant. Configure with the signed Resend webhook."
    },
    {
      "name": "MAIL_WEBHOOK_SECRET",
      "label": "Resend webhook signing secret",
      "kind": "secret",
      "input": "entered",
      "ownerVisible": true,
      "required": false,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "resend"
      },
      "help": "Optional Resend webhook signing secret for quote-delivery events."
    }
  ],
  "steps": [
    {
      "type": "extension",
      "id": "branding"
    },
    {
      "type": "owner-claim",
      "mode": "setup-token",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ]
}
