{
  "push": [
    {
      "name": "barrow-1",
      "browser": true,
      "hosted": true,
      "commands": [
        "node scripts/contract-docs.mjs check",
        "pnpm exec rer check --profile first-party",
        "pnpm run build",
        "pnpm run typecheck",
        "pnpm check:deployment-spec",
        "node scripts/edition-authoring/cli.mjs check",
        "node scripts/edition-authoring/cli.mjs verify-base --offline",
        "BARROW_TEST_SHARD=1/4 pnpm run test:api",
        "pnpm exec rer build --site",
        "node --test tests/site.test.mjs",
        "BARROW_JOURNEY_EVIDENCE=/tmp/barrow-credit-screens timeout 1200 node --test --test-concurrency=1 tests/journeys/credit-payments.test.mjs tests/journeys/credit-policy.test.mjs tests/journeys/deposits.test.mjs",
        "BARROW_JOURNEY_EVIDENCE=/tmp/barrow-prebook-screens timeout 1200 node --test --test-concurrency=1 --test-name-pattern='buyer books a spring season' tests/journeys/confirmations.test.mjs"
      ]
    },
